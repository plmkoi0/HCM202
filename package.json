{
  "name": "con-duong-tu-tuong-hcm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Board game kiểu cờ cá ngựa về Chủ đề 4 — HCM202 (sản phẩm sáng tạo thứ hai)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "import:questions": "node scripts/import-questions.mjs",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}

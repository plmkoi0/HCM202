{
  "name": "con-duong-tu-tuong-hcm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Board game kiểu cờ cá ngựa về Chủ đề 4 — HCM202 (sản phẩm sáng tạo thứ hai)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/dev.ts",
    "serve": "npm run build && tsx server/dev.ts --static dist",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline && node scripts/check-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "import:questions": "node scripts/import-questions.mjs",
    "simulate": "tsx scripts/simulate.ts",
    "sim:load": "tsx scripts/load-sim.ts",
    "e2e": "npm run e2e:local && npm run build && tsx scripts/e2e-online.ts",
    "check:deploy": "tsx scripts/check-deploy.ts",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:online": "tsx scripts/e2e-online.ts",
    "check:release": "node scripts/check-release.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "qr": "node scripts/make-qr.mjs",
    "set:bank-code": "node scripts/set-bank-code.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "lucide-react": "1.50.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "oxlint": "1.86.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}

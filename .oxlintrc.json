{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "eslint/no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__OFFLINE__",
          "__BANK_LOCK_TEST__"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "dist-offline/**",
    "node_modules/**"
  ]
}

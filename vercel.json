{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix San-pham-sang-tao/web",
  "buildCommand": "npm run build --prefix San-pham-sang-tao/web",
  "outputDirectory": "San-pham-sang-tao/web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}

# Biến môi trường cho server phòng chơi (mục 15.4). KHÔNG commit file .env thật.
#
# URL Redis giao thức TCP (rediss://…) — server đọc biến đầu tiên có giá trị theo thứ tự:
#   REDIS_URL → KV_URL → UPSTASH_REDIS_URL
# Gắn "Upstash for Redis" từ Vercel Marketplace thì Vercel tự thêm các biến này (thường là
# KV_URL, KV_REST_API_URL, KV_REST_API_TOKEN, KV_REST_API_READ_ONLY_TOKEN; có thể có REDIS_URL).
# Server chỉ cần URL TCP; các biến KV_REST_* (REST) không dùng tới.
# Kiểm tra sau khi deploy: mở /api/health → "store": "redis", "ok": true.
#
# Chạy cục bộ không đặt biến nào → kho trong bộ nhớ (một tiến trình, đủ để chơi thử).
# Muốn thử với Redis thật trên máy: cài redis-server rồi đặt
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# Server cục bộ (npm run server / npm run serve)
# PORT=8787
# HOST=0.0.0.0              # để điện thoại cùng Wi-Fi vào được
# SOCKET_MAX_LIFE_MS=300000 # giả lập giới hạn 300 s của Vercel Hobby (0 = không giới hạn)
